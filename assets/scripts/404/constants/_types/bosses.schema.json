{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^[A-Z0-9_]+$": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "ボスの名前"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "出現するステージのリスト"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ボスの部位リスト"
        }
      },
      "required": ["name", "stages"]
    }
  },
  "additionalProperties": false
}
